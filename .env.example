# ==========================================
# LINK KEEPER — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE CONFIGURATION (TURSO)
# Sign up at https://turso.tech, create a database with:
#   turso db create link-keeper
#   turso db show link-keeper --url
#   turso db tokens create link-keeper
# Note: If left unset in local development, Link Keeper automatically uses
# an embedded local SQLite file at ./data/linkkeeper.db so it runs out-of-the-box!
TURSO_DATABASE_URL="libsql://your-database-name-organization.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# 2. PRIVATE ACCESS & SECURITY
# Personal website access PIN required to unlock and manage your bookmarks.
# Verified server-side via PRIVATE_ACCESS_PIN.
# REQUIRED in production (no default). In dev, falls back to 123456 with a warning.
PRIVATE_ACCESS_PIN="your_access_pin_here"

# Cryptographic secret for signing HTTP-only session cookies (used only for session signing)
# REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your_random_32_character_session_secret_here"

# Optional (disabled when unset). Secondary secret key for external programmatic API access
PRIVATE_ACCESS_SECRET="your_private_api_secret_key_here"

# 3. SERVER CONFIGURATION
PORT=3000
NODE_ENV="development"
